+               run_id="rfail", reason="попытка")
+    evts = [e for e in events.list_events(after=start) if e["run_id"] == "rfail"]
+    assert evts[0]["kind"] == "action_failed"
+    assert "диск полон" in evts[0]["payload"]["error"]
