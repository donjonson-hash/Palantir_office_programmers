+        '{"action":"write_file","target":"repo","params":{"path":"b","content":"c"},"reason":"правка"}',
+        '{"done":true,"summary":"готово"}',
+    ]), GW)
+    run_id = runner.create_run("сделай правку", "bjorn")
+    st = runner.drive(run_id, office_agents, GW)
+    assert st["status"] == "done"
