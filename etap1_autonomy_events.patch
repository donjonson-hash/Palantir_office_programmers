+"""
+Тесты «стекла»: события публикуются на каждом значимом шаге и читаются курсором.
+Запуск:  cd office && python -m pytest -q
+"""
+import os
+import pathlib
+import tempfile
+
+ROOT = pathlib.Path(__file__).parent
