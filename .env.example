# Скопируй в .env. Файл .env в git не попадает.

# Подключение к проекту (без него исполнитель работает как заглушка)
WORKSPACE_ROOT=~/Projects/syndi-vercel
TEST_CMD=npm test
LINT_CMD=npm run lint

# LLM (AITunnel / DeepSeek), OpenAI-совместимый эндпоинт
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# URL шлюза для офиса
GATEWAY_URL=http://localhost:8000
